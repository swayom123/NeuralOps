{
  "name": "neuralops-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "contracts": "cd .. && uv run --directory services python ../scripts/export-openapi.py && web/node_modules/.bin/openapi-typescript packages/contracts/openapi.json -o web/lib/generated.ts",
    "format": "prettier --write app components lib/api.ts lib/types.ts tests next.config.ts proxy.ts playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.3",
    "typescript": "5.9.3"
  }
}
