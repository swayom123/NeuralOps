# Generate local secrets with python3 scripts/setup-local.py; do not copy placeholders into production.
ENVIRONMENT=development
DEV_AUTH=false
PUBLIC_ORIGIN=http://localhost:3000
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://neuralops:REPLACE_WITH_GENERATED_DATABASE_PASSWORD@127.0.0.1:15432/neuralops # pragma: allowlist secret — template placeholder only
API_INTERNAL_URL=http://127.0.0.1:8000
# Production: HTTPS, DEV_AUTH=false, dedicated least-privilege DB accounts and provisioned OIDC memberships.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
